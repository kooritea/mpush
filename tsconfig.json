{
  "ts-node": {
    "files": true
  },
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "lib": [
      "es2022"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./src/typings"
    ],
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}